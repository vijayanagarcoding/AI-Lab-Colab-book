import math
import random

def calculate_cost(board):
    attacks = 0
    n = len(board)
    for i in range(n):
        for j in range(i + 1, n):
            if board[i] == board[j] or abs(board[i] - board[j]) == abs(i - j):
                attacks += 1
    return attacks

def print_board(board):
    n = len(board)
    for r in range(n):
        row_str = " ".join("Q" if board[c] == r else "." for c in range(n))
        print(row_str)
    print(f"Cost: {calculate_cost(board)}\n")

def get_random_neighbor(board):
    n = len(board)
    neighbor = list(board)
    col = random.randint(0, n - 1)
    row = random.randint(0, n - 1)
    while neighbor[col] == row:
        row = random.randint(0, n - 1)
    neighbor[col] = row
    return neighbor

def simulated_annealing(n=8, max_iter=20000, initial_temp=100.0, cooling_rate=0.995):
    current = [random.randint(0, n - 1) for _ in range(n)]
    current_cost = calculate_cost(current)
    
    temp = initial_temp
    
    print(f"--- Initial Random State (Cost: {current_cost}) ---")
    print_board(current)
    
    for iteration in range(max_iter):
        if current_cost == 0:
            print(f"Solution found at iteration {iteration}!")
            return current
        
        if temp < 1e-4:
            print("Temperature dropped to zero. Restarting annealing...")
            current = [random.randint(0, n - 1) for _ in range(n)]
            current_cost = calculate_cost(current)
            temp = initial_temp
            continue
        
        neighbor = get_random_neighbor(current)
        neighbor_cost = calculate_cost(neighbor)
        
        delta_e = neighbor_cost - current_cost
        
        if delta_e < 0 or random.random() < math.exp(-delta_e / temp):
            current = neighbor
            current_cost = neighbor_cost
        
        temp *= cooling_rate
        
        if iteration % 2000 == 0:
            print(f"Iteration {iteration}: Temp = {temp:.4f}, Current Cost = {current_cost}")
                    
    return current

if __name__ == "__main__":
    print("=== 8-QUEENS SIMULATED ANNEALING ===")
    final_state = simulated_annealing(n=8)
    print("Final Solution Board Configuration:")
    print_board(final_state)
