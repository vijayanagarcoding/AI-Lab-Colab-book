import heapq
from collections import deque


MOVES = {
    'U': (-1, 0),
    'D': (1, 0),
    'L': (0, -1),
    'R': (0, 1)
}

TARGET_STATE = (1, 2, 3, 4, 5, 6, 7, 8, 0)


class PuzzleState:
    def __init__(self, board, parent=None, move="", depth=0, cost=0):
        self.board = tuple(board) 
        self.parent = parent
        self.move = move
        self.depth = depth
        self.cost = cost  
        self.blank_pos = self.board.index(0)

    def __lt__(self, other):
        return self.cost < other.cost

    def get_neighbors(self):
        neighbors = []
        r, c = divmod(self.blank_pos, 3)

        for move_name, (dr, dc) in MOVES.items():
            nr, nc = r + dr, c + dc
            if 0 <= nr < 3 and 0 <= nc < 3:
                new_blank = nr * 3 + nc
                board_list = list(self.board)
                
                board_list[self.blank_pos], board_list[new_blank] = board_list[new_blank], board_list[self.blank_pos]
                neighbors.append(PuzzleState(board_list, self, move_name, self.depth + 1))
        return neighbors

    def get_path(self):
        path = []
        curr = self
        while curr.parent:
            path.append(curr.move)
            curr = curr.parent
        return path[::-1]


def print_board(board):
    for i in range(0, 9, 3):
        print(" ".join(str(x) if x != 0 else "_" for x in board[i:i+3]))
    print()



def solve_dfs(start_board, max_depth=30):
    start_state = PuzzleState(start_board)
    stack = [start_state]
    visited = {start_state.board: 0}

    while stack:
        curr = stack.pop()

        if curr.board == TARGET_STATE:
            return curr.get_path(), curr.depth

        if curr.depth < max_depth:
            for neighbor in curr.get_neighbors():
                if neighbor.board not in visited or neighbor.depth < visited[neighbor.board]:
                    visited[neighbor.board] = neighbor.depth
                    stack.append(neighbor)
    return None, -1



def dls(state, limit, visited):
    """Depth-Limited Search helper for IDS."""
    if state.board == TARGET_STATE:
        return state

    if state.depth >= limit:
        return None

    for neighbor in state.get_neighbors():
        if neighbor.board not in visited or neighbor.depth < visited[neighbor.board]:
            visited[neighbor.board] = neighbor.depth
            result = dls(neighbor, limit, visited)
            if result:
                return result
    return None


def solve_ids(start_board, max_limit=50):
    for limit in range(max_limit):
        start_state = PuzzleState(start_board)
        visited = {start_state.board: 0}
        result = dls(start_state, limit, visited)
        if result:
            return result.get_path(), result.depth
    return None, -1



def manhattan_distance(board):
    distance = 0
    for i, tile in enumerate(board):
        if tile != 0:
            target_r, target_c = divmod(tile - 1, 3)
            curr_r, curr_c = divmod(i, 3)
            distance += abs(curr_r - target_r) + abs(curr_c - target_c)
    return distance


def solve_astar(start_board):
    start_state = PuzzleState(start_board)
    start_state.cost = start_state.depth + manhattan_distance(start_state.board)

    open_set = []
    heapq.heappush(open_set, start_state)
    visited = {start_state.board: start_state.depth}

    while open_set:
        curr = heapq.heappop(open_set)

        if curr.board == TARGET_STATE:
            return curr.get_path(), curr.depth

        for neighbor in curr.get_neighbors():
            g = neighbor.depth
            h = manhattan_distance(neighbor.board)
            neighbor.cost = g + h

            if neighbor.board not in visited or g < visited[neighbor.board]:
                visited[neighbor.board] = g
                heapq.heappush(open_set, neighbor)
    return None, -1


if __name__ == "__main__":
  
    initial_board = (1, 2, 3,
                     4, 0, 6,
                     7, 5, 8)

    print("--- INITIAL BOARD ---")
    print_board(initial_board)

 
    dfs_path, dfs_depth = solve_dfs(initial_board, max_depth=20)
    print(f"DFS Solution   : Moves={len(dfs_path)} | Depth={dfs_depth}")
    print(f"Moves          : {' -> '.join(dfs_path)}\n")

   
    ids_path, ids_depth = solve_ids(initial_board, max_limit=30)
    print(f"IDS Solution   : Moves={len(ids_path)} | Depth={ids_depth}")
    print(f"Moves          : {' -> '.join(ids_path)}\n")

   
    astar_path, astar_depth = solve_astar(initial_board)
    print(f"A* Solution    : Moves={len(astar_path)} | Depth={astar_depth}")
    print(f"Moves          : {' -> '.join(astar_path)}")
