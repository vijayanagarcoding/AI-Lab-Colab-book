import random

def calculate_cost(board):
    attacks = 0
    n = len(board)
    for i in range(n):
        for j in range(i + 1, n):
            if board[i] == board[j] or abs(board[i] - board[j]) == abs(i - j):
                attacks += 1
    return attacks

def print_board(board):
    n = len(board)
    for r in range(n):
        row_str = " ".join("Q" if board[c] == r else "." for c in range(n))
        print(row_str)
    print(f"Cost (Attacking Pairs): {calculate_cost(board)}\n")

def hill_climbing(initial_board):
    current = list(initial_board)
    current_cost = calculate_cost(current)
    steps = 0
    
    print(f"--- Initial State ---")
    print_board(current)
    
    while True:
        if current_cost == 0:
            print(f"Goal state reached successfully in {steps} steps!")
            return current
        
        neighbors = []
        for col in range(len(current)):
            for row in range(len(current)):
                if current[col] != row:
                    neighbor = list(current)
                    neighbor[col] = row
                    neighbors.append(neighbor)
        
        best_neighbor = None
        best_cost = current_cost
        
        for neighbor in neighbors:
            cost = calculate_cost(neighbor)
            if cost < best_cost:
                best_cost = cost
                best_neighbor = neighbor
        
        if best_neighbor is None or best_cost >= current_cost:
            print("Stuck in a local minimum. Restarting with a new random configuration...")
            current = [random.randint(0, len(initial_board) - 1) for _ in range(len(initial_board))]
            current_cost = calculate_cost(current)
            print_board(current)
            continue
        
        current = best_neighbor
        current_cost = best_cost
        steps += 1
        print(f"Step {steps} (Cost: {current_cost}):")
        print_board(current)

if __name__ == "__main__":
    initial_4q = (0, 1, 2, 3) 
    print("=== N-QUEENS HILL CLIMBING ===")
    solved_board = hill_climbing(initial_4q)
    print(f"Final Solution Board: {solved_board}")

